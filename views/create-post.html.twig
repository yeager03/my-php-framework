{% extends 'layouts/default.html.twig' %}

{% block main %}
    <section class="posts-create">
        <div class="container">
            <h1 class="title posts-create__title">Создание поста</h1>
            <form action="/posts" method="post" class="form posts-create__form">
                <div class="form__field">
                    <input type="text" name="title" class="form__input" placeholder="Заголовок" required>
                </div>
                <div class="form__field">
                    <textarea name="description" rows="10" class="form__textarea" placeholder="Описание" required ></textarea>
                </div>
                <button type="submit" class="button form__button">Добавить пост</button>
            </form>
        </div>
    </section>
{% endblock %}