<header class="header">
    <div class="container">
        <div class="header__wrapper">
            <a href="{{ WWW }}" class="logo">
                <span class="logo__text">
                    PHP-FRAMEWORK
                </span>
            </a>

            <nav class="nav">
                <ul class="nav__list">
                    <li class="nav__item">
                        <a href="/posts" class="nav__link">Посты</a>
                    </li>
                    <li class="nav__item">
                        <a href="/posts/create" class="nav__link">Создать пост</a>
                    </li>
                </ul>
            </nav>

            <div class="account">
                {% if auth().check() %}
                    <form action="/logout" method="post">
                        <button class="account__wrapper account__wrapper--danger">
                        <span class="account__text">
                            Выход
                        </span>
                        </button>
                    </form>
                {% else %}
                    <a href="/sign-in" class="account__wrapper">
                    <span class="account__icon"
                          style="background-image: url('{{ WWW }}/public/assets/icons/login.svg')">
                    </span>
                        <span class="account__text">
                        Личный кабинет
                    </span>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>