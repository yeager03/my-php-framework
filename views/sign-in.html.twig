{% extends 'layouts/default.html.twig' %}

{% block main %}
    <section class="sign-in">
        <div class="container">
            <div class="sign-in__wrapper">
                <div class="sign-in__form">
                    <h1 class="title sign-in__title">Вход</h1>
                    {% if session().hasFlash("error") %}
                        <div class="alert alert--danger">
                            <ul>
                                {% for error in session().getFlash("error") %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                    <form action="/sign-in" method="post" class="form">
                        <div class="form__field">
                            <input type="email" name="email" class="form__input" placeholder="Введите ваш email" required>
                        </div>
                        <div class="form__field">
                            <input type="password" name="password" class="form__input" placeholder="Введите ваш пароль" required>
                        </div>
                        <p class="form__info">Нет аккаунта? <a href="/sign-up">Регистрация</a></p>
                        <button type="submit" class="button form__button">Войти</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}